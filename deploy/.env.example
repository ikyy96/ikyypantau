# ============================================================
# Environment Variables - Lab Monitoring System
# Copy jadi .env di root project:  cp deploy/.env.example .env
# Lalu ubah nilainya. File .env dibaca oleh systemd
# (EnvironmentFile) atau bisa juga di-export manual.
# ============================================================

# --- Keamanan ---
# Password admin untuk login dashboard (WAJIB diganti!)
LAB_PASSWORD=ganti-password-kuat-anda

# Secret key session cookie (bebas, string acak panjang)
# Generate: openssl rand -hex 32
LAB_SECRET_KEY=ganti-dengan-string-random-32-byte

# Token autentikasi agent (opsional; agent.py versi terbaru tidak mewajibkannya)
LAB_AGENT_TOKEN=lab-token-2024

# --- Google OAuth ---
# Client ID dari Google Cloud Console
GOOGLE_CLIENT_ID=1024514167323-0pc62a62d85jrjor7tqaeme12lt7pk2n.apps.googleusercontent.com

# Daftar email yang boleh login (pisahkan dengan koma, tanpa spasi)
# Boleh dikosongkan kalau pakai allowed_emails.json
ALLOWED_EMAILS=rizkyharun122@gmail.com
